# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:3000

# ─── Security — CHANGE BEFORE DEPLOYING ──────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# ─── Admin account ────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=admin123

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=chatdoc
POSTGRES_PASSWORD=chatdoc_secret
POSTGRES_DB=chatdoc

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── AI Providers (add keys as needed, or use Ollama with no keys) ────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ─── Ollama (only used when started with --profile ollama) ───────────────────
# OLLAMA_URL=http://ollama:11434
